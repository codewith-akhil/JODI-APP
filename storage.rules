rules_version = '2';

// Soulmate Matrimony — Cloud Storage security rules.
// Paths mirror FirebaseManager.kt storage constants:
//   profile_photos/, govt_id_proofs/, chat_media/, horoscope_docs/
service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos — visible to signed-in members, writable by the owner only.
    match /profile_photos/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.size < 10 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Government ID proofs — strictly private: owner upload/read only.
    // Trust & Safety review happens via Admin SDK (bypasses rules).
    match /govt_id_proofs/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.size < 10 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Horoscope documents — private to the owner, max 5 MB.
    match /horoscope_docs/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.size < 5 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Chat media — only participants of the thread may read or upload.
    // threadId is the two uids sorted and joined with '_' (see chatThreadId()).
    match /chat_media/{threadId}/{fileName} {
      allow read: if request.auth != null
                  && (threadId.matches(request.auth.uid + '_.*')
                      || threadId.matches('.*_' + request.auth.uid));
      allow create, update: if request.auth != null
                            && (threadId.matches(request.auth.uid + '_.*')
                                || threadId.matches('.*_' + request.auth.uid))
                            && request.resource.size < 10 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                    && (threadId.matches(request.auth.uid + '_.*')
                        || threadId.matches('.*_' + request.auth.uid));
    }

    // Everything else: deny by default (implicit).
  }
}
